; ==============================================================================
; 01_GOLD_XAUUSD_Champion_41K_DualSession_MT4.set
; ------------------------------------------------------------------------------
; Ultimate Institutional Prop Firm High-Payoff Preset for MT4 (Gold XAUUSD, M5)
; Compatible with: Ultimate_ICT_Scalper_v3.1.ex4 & PropFirm_Titan_v1.0.ex4
; Verified for: Exness Raw / Standard (XAUUSD / XAUUSDr)
; Matching MT5 Champion Record: Net +$41.2k/yr | PF 2.48 | WR 93.4% | Max DD 2.84%
; ==============================================================================

; --- Lot Sizing & Dynamic Risk Control ---
LotCalcMode=0
FixedLotSize=0.10
RiskPercent=1.00
MaxDailyRiskPercent=3.00
MaxDailyProfitPercent=10.00
MaxPositions=1
MaxDailyTrades=10
MaxDailyLosses=2
UseDrawdownBrake=true
BrakeTriggerDD=2.00

; --- Institutional Safety Belt (Prop Firm Protection) ---
UseSafetyBelt=false
MaxAllowedDailyDD=3.00
MaxAllowedTotalDD=5.50
AutoCloseOnEmergency=true
CloseFridayNight=true
FridayCloseHour=21
AvoidFridayAfternoon=true
AvoidMonday=false
AvoidRolloverSpread=true
UseStreakRiskReducer=true

; --- Predictive Quality & Spread Gates (MT4 Calibrated) ---
UseSpreadToATRGate=true
MaxSpreadToATRRatio=0.22
MinATR_Points=50.0
MaxSpreadPoints=250.0
ATR_SL_Multiplier=0.95
ATR_TP_Multiplier=4.00

; --- ICT Strategy Parameters (Sweeps & Fair Value Gaps) ---
UseLiquiditySweeps=true
UseFairValueGaps=true
LiquidityLookback=40
FVG_Lookback=20
FVG_MinSizeATR=0.25
RequireBothFVGAndSweep=false

; --- Candlestick & Micro Structure Confirmation ---
UseChartPatterns=false
UseRejectionPinBar=true
UseEngulfingBar=true
UseStructureShift=true
FilterMomentumKnives=true

; --- Session Settings (London & New York Dual Exploitation) ---
TradeAsianSession=false
TradeLondonSession=true
TradeNewYorkSession=true
LondonStartHour=7
NewYorkStartHour=13

; --- Silver Bullet Execution Windows ---
UseSilverBullet=true
LondonSilverBullet=true
LondonKillZoneStart=8
LondonKillZoneStartMin=0
LondonKillZoneEnd=11
LondonKillZoneEndMin=0
NewYorkSilverBullet=true
NYKillZoneStart=13
NYKillZoneStartMin=30
NYKillZoneEnd=17
NYKillZoneEndMin=0

; --- Position Management (High Payoff 4:1 Trailing & Partial Close) ---
UseBreakEven=true
BE_TriggerATR=1.00
BE_OffsetPoints=45
UseTrailingStop=true
UseStructuralTrailing=true
Trail_StartATR=1.50
Trail_StepATR=0.85
UseSmartExhaustion=false
UseSmartLossCutter=false
UsePartialClose=true
PartialClosePercent=40.0
PartialCloseTriggerATR=1.15

; --- Multi-Timeframe Trend Confluence (MT4 Native Enums) ---
; In MT4: PERIOD_H1 = 60, PERIOD_H4 = 240
BiasFastTimeframe=60
BiasFastPeriod=34
BiasSlowTimeframe=240
BiasSlowPeriod=200
UseMacroTrendFilter=true
MacroTrendPeriod=50

; --- Adaptive Market Regime (Volatility Buffer for Gold) ---
UseAdaptiveRegime=false
HighVolATR_Points=150.0
HighVolMaxTriggerPoints=120.0
HighVolBEOffsetATR=0.20
HighVolTrailStepATR=0.95

; --- Execution & System Settings ---
MagicNumber=208821
SlippagePoints=10
OrderRetryCount=3
OrderRetryDelayMs=250
MinBarsBetweenTrades=0
